# =============================================================================
# WAX IPFS Pinning Utility - Environment Configuration
# =============================================================================
# Copy this file to .env and configure the values for your deployment

# -----------------------------------------------------------------------------
# CORE CONFIGURATION
# -----------------------------------------------------------------------------

# AtomicAssets API endpoint for fetching WAX blockchain NFT data
ATOMIC_API_URL=https://atomic.waxnet.io


# Configuration file path for collections and tokens to process (default: ./object.json)
# Useful for job chunking - specify different files for different scheduled jobs
# OBJECT_FILE=./object-chunk-1.json

# Object file chunking configuration (for scripts/chunk-object-file.sh)
# Number of collections per chunk file (default: 10)
# COLLECTIONS_PER_CHUNK=10
# Source object file to chunk (default: ./object.json)  
# SOURCE_OBJECT_FILE=./object.json
# Output directory for chunk files (default: ./chunks)
# CHUNK_OUTPUT_DIR=./chunks
# Prefix for chunk filenames (default: object-chunk)
# CHUNK_FILE_PREFIX=object-chunk

# Auto-chunk progression mode (automatically process chunk files in sequence)
# When enabled, the app will automatically find and process the next unprocessed chunk
# AUTO_CHUNK_MODE=1

# Auto-chunk cycling mode (restart from first chunk when all chunks are complete)
# When disabled (default), the app exits when all chunks are complete
# When enabled, the app clears progress and starts over from the first chunk
# AUTO_CHUNK_CYCLE=0

# Directory to search for chunk files (default: ./chunks)
# CHUNK_DIRECTORY=./chunks
# Prefix pattern to match chunk files (default: object-chunk)
# CHUNK_FILE_PREFIX=object-chunk

# -----------------------------------------------------------------------------
# IPFS PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------

# IPFS provider type: 'pinata' or 'local'
# - pinata: Use Pinata cloud service (requires PINATA_JWT)
# - local: Use local IPFS node (requires IPFS_API_URL and IPFS_GATEWAY_URL)
IPFS_PROVIDER=pinata

# Pinata Configuration (when IPFS_PROVIDER=pinata)
# JWT token from your Pinata account for API authentication
PINATA_JWT=your_pinata_jwt_token_here

# Local IPFS Node Configuration (when IPFS_PROVIDER=local)
# API endpoint for your local IPFS node
# IPFS_API_URL=http://localhost:5001

# Gateway URL for your local IPFS node
# IPFS_GATEWAY_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# IPFS VERIFICATION
# -----------------------------------------------------------------------------

# Gateway URL used to verify hash existence before pinning
# Defaults to Pinata gateway if not specified
IPFS_VERIFICATION_GATEWAY=https://gateway.pinata.cloud

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

# Enable/disable NFT collection processing (0=disabled, 1=enabled)
UPLOAD_COLLECTION_NFT=1

# Enable/disable token metadata processing (0=disabled, 1=enabled)
UPLOAD_TOKEN=1

# -----------------------------------------------------------------------------
# DRY RUN CONFIGURATION
# -----------------------------------------------------------------------------

# Enable dry run mode to analyze what would be pinned without actual pinning (0=disabled, 1=enabled)
DRY_RUN=0

# Limit number of assets processed in dry run mode (default: 25, use -1 for unlimited)
DRY_RUN_LIMIT=25

# -----------------------------------------------------------------------------
# PROGRESS MANAGEMENT
# -----------------------------------------------------------------------------

# Clear all progress data and start from scratch (0=resume from previous state, 1=fresh start)
FRESH_START=0

# Limit the number of pages to process per collection to prevent memory issues (-1=unlimited)
# Recommended: 50-100 for large collections, -1 for small collections
# Large collections like mlb.topps benefit from page limiting to manage memory usage
MAX_PAGES_PER_COLLECTION=-1

# -----------------------------------------------------------------------------
# RATE LIMITING CONFIGURATION
# -----------------------------------------------------------------------------

# Pinata plan type for optimized rate limiting (free, picnic, fiesta, or custom)
# This automatically sets optimal delay and batch size based on your plan's limits
# free: 60 req/min (1000ms delay), picnic: 250 req/min (240ms delay), fiesta: 500 req/min (120ms delay)
PINATA_PLAN=free

# Manual delay between API requests in milliseconds (overrides PINATA_PLAN if set)
# Free: 1000ms (60 req/min), Picnic: 240ms (250 req/min), Fiesta: 120ms (500 req/min)
# RATE_LIMIT_DELAY_MS=1000

# Number of hashes to process per batch (default: 10, increase for paid plans)
# Free: 10, Picnic: 25, Fiesta: 50 (larger batches are more efficient for paid plans)
# BATCH_SIZE=10

# -----------------------------------------------------------------------------
# HASH TRACKING AND REPORTING
# -----------------------------------------------------------------------------

# Track and report unique IPFS hashes discovered during processing (0=disabled, 1=enabled)
TRACK_UNIQUE_HASHES=1

# Track and report hashes not found on IPFS network (0=disabled, 1=enabled)
TRACK_NOT_FOUND_HASHES=1

# Save detailed hash tracking report to file (0=disabled, 1=enabled)
SAVE_HASH_REPORT=1

# Directory path for saving hash tracking reports (default: ./reports)
HASH_REPORT_DIR=./reports

# -----------------------------------------------------------------------------
# SLACK NOTIFICATIONS
# -----------------------------------------------------------------------------

# Slack Bot Token and Channel for job notifications
# SLACK_TOKEN=xoxb-your-bot-token-here
# SLACK_CHANNEL=general

# -----------------------------------------------------------------------------
# ERROR HANDLING AND RELIABILITY
# -----------------------------------------------------------------------------

# AtomicAssets API timeout in milliseconds (default: 60000, range: 10000-300000)
# Controls how long to wait for API responses before timing out
ATOMIC_API_TIMEOUT_MS=60000

# Number of retries for AtomicAssets fetch operations (default: 10, range: 1-50)
# Internal retry count handled by @waxio/fetch-retry library
ATOMIC_API_RETRIES=10

# Maximum retry attempts for individual AtomicAssets operations (default: 3, range: 1-10)
# Application-level retries with exponential backoff for failed operations
ATOMIC_RETRY_MAX_ATTEMPTS=3

# Base delay in milliseconds for retry attempts (default: 1000, range: 100-10000)
# Initial delay that increases exponentially with each retry attempt
ATOMIC_RETRY_BASE_DELAY_MS=1000

# Enable graceful recovery from network failures (0=disabled, 1=enabled)
# When enabled, the app continues processing other data if one collection/token fails
ENABLE_GRACEFUL_RECOVERY=1

# Maximum consecutive failures before triggering recovery mode (default: 3, range: 1-10)
# Prevents infinite retry loops and enables partial processing
MAX_CONSECUTIVE_FAILURES=3

# -----------------------------------------------------------------------------
# DEBUGGING CONFIGURATION
# -----------------------------------------------------------------------------

# Enable authentication debugging for CI/cloud troubleshooting (0=disabled, 1=enabled)
# This will test Pinata authentication and show network/IP diagnostics
# DEBUG_AUTH=1