{
  "name": "@wax-io/atomic-pinner",
  "version": "0.1.0",
  "description": "Pin the IPFS content referenced by AtomicAssets NFTs (WAX and other Antelope chains) to Pinata or your own IPFS node, with resumable progress and rate limiting.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldwide-asset-exchange/atomic-pinner.git"
  },
  "bugs": {
    "url": "https://github.com/worldwide-asset-exchange/atomic-pinner/issues"
  },
  "homepage": "https://github.com/worldwide-asset-exchange/atomic-pinner#readme",
  "keywords": [
    "ipfs",
    "pinning",
    "pinata",
    "nft",
    "atomicassets",
    "wax",
    "antelope",
    "eosio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prettier": "prettier -w .",
    "prettier:check": "prettier -c ."
  },
  "dependencies": {
    "@wharfkit/antelope": "^1.0.7",
    "@wharfkit/atomicassets": "^1.2.1",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.2.0",
    "lowdb": "^7.0.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.16.1",
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.3.3",
    "tsx": "^4.18.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
