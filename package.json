{
  "name": "@wax-io/atomic-pinner",
  "version": "0.2.0",
  "description": "Pin the IPFS content referenced by AtomicAssets NFTs (WAX and other Antelope chains) to Pinata or your own IPFS node, with resumable progress and rate limiting.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "atomic-pinner": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldwide-asset-exchange/atomic-pinner.git"
  },
  "bugs": {
    "url": "https://github.com/worldwide-asset-exchange/atomic-pinner/issues"
  },
  "homepage": "https://github.com/worldwide-asset-exchange/atomic-pinner#readme",
  "keywords": [
    "ipfs",
    "pinning",
    "pinata",
    "kubo",
    "nft",
    "atomicassets",
    "wax",
    "antelope",
    "eosio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs": "tsx scripts/update-docs.ts",
    "docs:check": "tsx scripts/update-docs.ts --check",
    "prettier": "prettier -w .",
    "prettier:check": "prettier -c .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "dotenv": "^17.2.0",
    "lowdb": "^7.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.16.1",
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.3.3",
    "tsx": "^4.18.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
